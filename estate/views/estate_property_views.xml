<odoo>
  <!-- Vue liste pour le modèle estate.property -->
  <record id="estate_property_view_list" model="ir.ui.view">
    <field name="name">estate.property.list</field>
    <field name="model">estate.property</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Liste des Propriétés">
        <field name="name"/>
        <field name="postcode"/>
      </list>
    </field>
  </record>

  <!-- Vue formulaire pour le modèle estate.property -->
  <record id="view_estate_property_form" model="ir.ui.view">
    <field name="name">estate.property.form</field>
    <field name="model">estate.property</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Propriété">
        <sheet>
          <group>
            <field name="name"/>
            <field name="expected_price"/>
            <field name="selling_price"/>
          </group>
          <group>
            <field name="description"/>
            <field name="postcode"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action liant le modèle aux vues -->
  <record id="estate_property_action" model="ir.actions.act_window">
    <field name="name">Propriétés</field>
    <field name="res_model">estate.property</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="estate_property_view_list"/>
  </record>
</odoo>
