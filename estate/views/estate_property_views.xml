<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vue Liste pour estate.property -->
  <record id="estate_property_view_list" model="ir.ui.view">
    <field name="name">estate.property.list</field>
    <field name="model">estate.property</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list string="Liste des Propriétés">
        <field name="name"/>
        <field name="postcode"/>
        <field name="expected_price"/>
        <field name="selling_price"/>
      </list>
    </field>
  </record>

  <!-- Vue Formulaire pour estate.property -->
  <record id="estate_property_view_form" model="ir.ui.view">
    <field name="name">estate.property.form</field>
    <field name="model">estate.property</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form string="Propriété">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="expected_price"/>
              <field name="selling_price"/>
            </group>
            <group>
              <field name="postcode"/>
              <field name="date_availability"/>
            </group>
          </group>
          <notebook>
            <page string="Description">
              <field name="description"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Vue de Recherche pour estate.property -->
<record id="estate_property_view_search" model="ir.ui.view">
    <field name="name">estate.property.search</field>
    <field name="model">estate.property</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
        <search string="Rechercher une Propriété">
            <field name="name"/>
            <field name="postcode"/>
            <!-- Filtre pour les propriétés disponibles : utiliser une liste pour le domaine -->
            <filter string="Disponibles" domain="[('state','in', ['new', 'offer_received'])]"/>
            <!-- Groupe de regroupement par code postal -->
            <group expand="0" string="Group By">
                <filter name="group_by_postcode" string="Code Postal" context="{'group_by':'postcode'}"/>
            </group>
        </search>
    </field>
</record>




  <!-- Action qui lie le modèle aux vues -->
  <record id="estate_property_action" model="ir.actions.act_window">
    <field name="name">Propriétés</field>
    <field name="res_model">estate.property</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="estate_property_view_list"/>
  </record>
</odoo>
