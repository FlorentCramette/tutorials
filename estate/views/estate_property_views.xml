<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste personnalisée -->
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Liste des Propriétés">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire personnalisée -->
<record id="estate_property_view_form" model="ir.ui.view">
    <field name="name">estate.property.form</field>
    <field name="model">estate.property</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
        <form string="Propriété">
            <sheet>
                <group>
                    <group>
                    <label string="My new house" style="font-weight: bold; font-size: 16px;"/>
                    </group>
                    <group>
                        <field name="postcode"/>
                        <field name="date_availability" options="{'datepicker': {'min_date': 'today'}}"/>
                    </group>
                    <group>
                        <field name="expected_price"/>
                        <field name="selling_price"/>
                    </group>  
                </group>
                <notebook>
                    <page string="Description">
                        <group>
                            <!-- Champs qui apparaîtront dans l'onglet "Description" -->
                            <field name="description"/>
                            <field name="bedrooms"/>
                            <field name="living_area"/>
                            <field name="facades"/>
                            <field name="garage"/>
                            <field name="garden_area">
                                <attribute name="invisible">[('garden', '=', False)]</attribute>
                            </field>
                            <field name="garden_orientation">
                                <attribute name="invisible">[('garden', '=', False)]</attribute>
                            </field>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>


    <!-- Vue recherche personnalisée -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Rechercher une Propriété">
                <!-- Champs de recherche -->
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                
                <!-- Filtre pour les propriétés disponibles -->
                <filter string="Available" name="available" domain="[('state', 'in', ['new', 'offer_received'])]"/>
                
                <!-- Regroupement par code postal -->
                <group expand="1" string="Group By">
                    <filter string="Postcode" name="group_by_postcode" context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action window for estate.property -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property!
            </p>
        </field>
    </record>
</odoo>
